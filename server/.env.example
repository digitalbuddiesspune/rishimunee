PORT=8000
NODE_ENV=development

# Comma-separated browser origins allowed to call the API (scheme + host, no trailing slash).
# Include every live frontend origin. www and non-www are auto-expanded from each entry.
CLIENT_URL=http://localhost:3000
# Production example:
# CLIENT_URL=https://www.risheemuni.in,https://risheemuni.in

SERVER_PUBLIC_URL=http://localhost:8000
MONGODB_URI=
JWT_SECRET=
OPENAI_API_KEY=
